# Environment variables (NEVER commit!)
.env

# Dependencies
node_modules/

# Logs - ignore contents but keep folders
*/logs/*
!*/logs/.gitkeep

# Output - ignore contents but keep folders
*/output/*
!*/output/.gitkeep

# Data - ignore contents but keep folders
*/data/*
!*/data/.gitkeep

# Temporary JSON files (but not package files)
*.json
!package.json
!package-lock.json
!athletic-net/verified-identity-decisions.json
!athletic-net/new-identity-decisions.json
!athletic-net/split-identity-decisions.json
!athletic-net/profile-identity-decisions.json
!athletic-net/name-correction-decisions.json
!athletic-net/verified-identity-decisions-batch-2.json

# Python
__pycache__/
*.pyc
.venv/
