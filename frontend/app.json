{
  "expo": {
    "name": "TrackHub",
    "slug": "trackhub",
    "version": "1.0.0",
    "description": "Track college track & field performances, meet results, and athlete stats. Compare athletes head-to-head, follow your favorite runners, and never miss a PR.",
    "orientation": "portrait",
    "icon": "./assets/images/app_icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#87CEEB"
    },
    "scheme": "trackhub",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mokeyzz.trackhub",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "TrackHub uses local network access for development purposes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#87CEEB"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.mokeyzz.trackhub"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 400,
          "resizeMode": "contain",
          "backgroundColor": "#87CEEB"
        }
      ],
      "expo-web-browser",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6534a3f3-d6c2-4e78-9259-7d4b981138d6"
      }
    },
    "owner": "mokeyz",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/6534a3f3-d6c2-4e78-9259-7d4b981138d6"
    }
  }
}
